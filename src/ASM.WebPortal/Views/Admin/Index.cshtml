@using System.Linq
@model AdminDashboardPageViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var weeklyAccessMax = Math.Max(1, Model.Summary.OwnerAccessLast7Days.Select(x => x.AccessCount).DefaultIfEmpty(0).Max());
    var monthlyAccessMax = Math.Max(1, Model.Summary.OwnerAccessLast30Days.Select(x => x.AccessCount).DefaultIfEmpty(0).Max());
}

<section class="hero-card p-4 p-md-5 mb-4">
    <div class="dashboard-hero-grid">
        <div>
            <div class="text-uppercase small text-muted">ASM Platform</div>
            <h1 class="display-6 fw-bold mb-2">System administration dashboard</h1>
            <p class="text-muted mb-0">Track owner activity, usage frequency, and tenant-level operational signals across the ASM platform.</p>
        </div>
        <div class="dashboard-hero-actions">
            <a class="btn btn-dark" asp-controller="Admin" asp-action="Owners">Open Owner Tracking</a>
        </div>
    </div>
</section>

<section class="dashboard-metric-grid mb-4">
    <article class="metric-card metric-card-slate">
        <div class="dashboard-metric-label">Tenants</div>
        <div class="dashboard-metric-value">@Model.Summary.TotalTenants</div>
        <div class="dashboard-metric-note">Organizations using the platform</div>
    </article>
    <article class="metric-card metric-card-navy">
        <div class="dashboard-metric-label">Owners</div>
        <div class="dashboard-metric-value">@Model.Summary.TotalOwners</div>
        <div class="dashboard-metric-note">Registered warehouse owners</div>
    </article>
    <article class="metric-card metric-card-green">
        <div class="dashboard-metric-label">Active Owners 7d</div>
        <div class="dashboard-metric-value">@Model.Summary.ActiveOwnersLast7Days</div>
        <div class="dashboard-metric-note">Owners with recent activity</div>
    </article>
    <article class="metric-card metric-card-gold">
        <div class="dashboard-metric-label">Audit Events 7d</div>
        <div class="dashboard-metric-value">@Model.Summary.TotalAuditEventsLast7Days</div>
        <div class="dashboard-metric-note">Operational actions across tenants</div>
    </article>
    <article class="metric-card metric-card-rust">
        <div class="dashboard-metric-label">Orders 7d</div>
        <div class="dashboard-metric-value">@Model.Summary.TotalOrdersLast7Days</div>
        <div class="dashboard-metric-note">Inbound and outbound created recently</div>
    </article>
    <article class="metric-card metric-card-sand">
        <div class="dashboard-metric-label">Scans 7d</div>
        <div class="dashboard-metric-value">@Model.Summary.TotalScansLast7Days</div>
        <div class="dashboard-metric-note">Warehouse scan traffic this week</div>
    </article>
</section>

<section class="panel-card owner-access-panel p-4 mb-4" data-owner-access-chart>
    <div class="dashboard-section-head">
        <div>
            <div class="dashboard-section-title">Owner Access Frequency</div>
            <div class="dashboard-section-subtitle">Successful web logins and authenticated API sessions for each Owner.</div>
        </div>
        <div class="owner-access-toggle" role="group" aria-label="Owner access period">
            <button class="owner-access-toggle-button active" type="button" data-owner-access-toggle="week" aria-pressed="true">Last 7 days</button>
            <button class="owner-access-toggle-button" type="button" data-owner-access-toggle="month" aria-pressed="false">Last 30 days</button>
        </div>
    </div>

    <div class="owner-access-chart" data-owner-access-period="week">
        @if (Model.Summary.OwnerAccessLast7Days.Count == 0)
        {
            <div class="dashboard-empty-state">No Owner accounts are available to track yet.</div>
        }
        @foreach (var access in Model.Summary.OwnerAccessLast7Days)
        {
            var width = access.AccessCount == 0 ? 0 : Math.Max(4, access.AccessCount * 100 / weeklyAccessMax);
            <a class="owner-access-row" asp-controller="Admin" asp-action="Owner" asp-route-id="@access.OwnerUserId">
                <div class="owner-access-identity">
                    <strong>@access.OwnerFullName</strong>
                    <span>@access.TenantName</span>
                </div>
                <div class="owner-access-bar-shell" aria-hidden="true">
                    <div class="owner-access-bar" style="width: @width%"></div>
                </div>
                <div class="owner-access-count">
                    <strong>@access.AccessCount</strong>
                    <span>accesses</span>
                </div>
            </a>
        }
    </div>

    <div class="owner-access-chart" data-owner-access-period="month" hidden>
        @if (Model.Summary.OwnerAccessLast30Days.Count == 0)
        {
            <div class="dashboard-empty-state">No Owner accounts are available to track yet.</div>
        }
        @foreach (var access in Model.Summary.OwnerAccessLast30Days)
        {
            var width = access.AccessCount == 0 ? 0 : Math.Max(4, access.AccessCount * 100 / monthlyAccessMax);
            <a class="owner-access-row" asp-controller="Admin" asp-action="Owner" asp-route-id="@access.OwnerUserId">
                <div class="owner-access-identity">
                    <strong>@access.OwnerFullName</strong>
                    <span>@access.TenantName</span>
                </div>
                <div class="owner-access-bar-shell" aria-hidden="true">
                    <div class="owner-access-bar owner-access-bar-month" style="width: @width%"></div>
                </div>
                <div class="owner-access-count">
                    <strong>@access.AccessCount</strong>
                    <span>accesses</span>
                </div>
            </a>
        }
    </div>

</section>

<section id="team-activity" class="panel-card team-activity-panel p-4 mb-4" data-team-activity-section>
    <div class="dashboard-section-head">
        <div>
            <div class="dashboard-section-title">Manager and Staff Activity by Owner</div>
            <div class="dashboard-section-subtitle">Choose an Owner to review daily activity within that Owner's organization.</div>
        </div>
        @if (Model.OwnerOptions.Count > 0)
        {
            <form asp-action="Index" method="get" class="team-activity-filter" data-team-activity-filter>
                <label for="teamOwnerId">Owner</label>
                <select id="teamOwnerId" name="ownerId" class="form-select form-select-sm" data-team-owner-select>
                    @foreach (var owner in Model.OwnerOptions)
                    {
                        if (owner.OwnerUserId == Model.SelectedOwnerId)
                        {
                            <option value="@owner.OwnerUserId" selected>@owner.OwnerFullName - @owner.TenantName</option>
                        }
                        else
                        {
                            <option value="@owner.OwnerUserId">@owner.OwnerFullName - @owner.TenantName</option>
                        }
                    }
                </select>
                <label for="adminTeamWarehouseId">Warehouse</label>
                <select id="adminTeamWarehouseId" name="warehouseId" class="form-select form-select-sm" data-team-warehouse-select>
                    @if (Model.TeamActivity?.WarehouseId is null)
                    {
                        <option value="" selected>All warehouses</option>
                    }
                    else
                    {
                        <option value="">All warehouses</option>
                    }
                    @foreach (var warehouse in Model.TeamActivity?.Warehouses ?? [])
                    {
                        if (warehouse.Id == Model.TeamActivity?.WarehouseId)
                        {
                            <option value="@warehouse.Id" selected>@warehouse.Name (@warehouse.Code)</option>
                        }
                        else
                        {
                            <option value="@warehouse.Id">@warehouse.Name (@warehouse.Code)</option>
                        }
                    }
                </select>
                <input type="hidden" name="days" value="@(Model.TeamActivity?.Days == 30 ? 30 : 7)" data-team-days-input />
                <div class="team-activity-period" role="group" aria-label="Team activity period">
                    <button type="button" value="7" class="@(Model.TeamActivity?.Days == 7 ? "active" : string.Empty)" data-team-days-option aria-pressed="@(Model.TeamActivity?.Days == 7 ? "true" : "false")">7 days</button>
                    <button type="button" value="30" class="@(Model.TeamActivity?.Days == 30 ? "active" : string.Empty)" data-team-days-option aria-pressed="@(Model.TeamActivity?.Days == 30 ? "true" : "false")">30 days</button>
                </div>
                <button type="submit" class="btn btn-dark btn-sm team-activity-search-button">Search</button>
            </form>
        }
    </div>

    @if (Model.TeamActivity is { } adminTeamActivity)
    {
        <div class="team-activity-scope">Showing: <strong>@adminTeamActivity.TenantName</strong> / <strong>@adminTeamActivity.WarehouseName</strong></div>
        <partial name="_TeamActivityChart" model="adminTeamActivity" />
    }
    else
    {
        <div class="dashboard-empty-state">No Owner is available for team activity tracking.</div>
    }
</section>

<div class="row g-4">
    <div class="col-xl-7">
        <section class="panel-card p-4 h-100">
            <div class="dashboard-section-head">
                <div>
                    <div class="dashboard-section-title">Most Active Owners</div>
                    <div class="dashboard-section-subtitle">Quick view of the owners with the freshest activity on the platform.</div>
                </div>
                <a class="btn btn-outline-dark btn-sm" asp-controller="Admin" asp-action="Owners">View all</a>
            </div>

            <div class="owner-admin-stack">
                @foreach (var owner in Model.Owners)
                {
                    <a class="owner-admin-card text-decoration-none text-dark" asp-controller="Admin" asp-action="Owner" asp-route-id="@owner.OwnerUserId">
                        <div class="owner-admin-top">
                            <div>
                                <div class="small text-muted">@owner.TenantName</div>
                                <div class="fw-bold">@owner.OwnerFullName</div>
                            </div>
                            <span class="dashboard-status-pill @(owner.IsActive ? "completed" : "")">@(owner.IsActive ? "Active" : "Disabled")</span>
                        </div>
                        <div class="owner-admin-grid">
                            <div>
                                <div class="order-meta-label">Actions 7d</div>
                                <div class="order-meta-value">@owner.OwnerActionsLast7Days</div>
                            </div>
                            <div>
                                <div class="order-meta-label">Orders 7d</div>
                                <div class="order-meta-value">@owner.TenantOrdersLast7Days</div>
                            </div>
                            <div>
                                <div class="order-meta-label">Scans 7d</div>
                                <div class="order-meta-value">@owner.TenantScansLast7Days</div>
                            </div>
                            <div>
                                <div class="order-meta-label">Last Activity</div>
                                <div class="order-meta-value">@(owner.LastActivityAtUtc?.ToLocalTime().ToString("dd/MM HH:mm") ?? "No activity")</div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </section>
    </div>

    <div class="col-xl-5">
        <section class="panel-card p-4 h-100">
            <div class="dashboard-section-head">
                <div>
                    <div class="dashboard-section-title">Recent Alerts</div>
                    <div class="dashboard-section-subtitle">Cross-tenant platform issues detected from recent scan errors.</div>
                </div>
            </div>

            <div class="dashboard-alert-list">
                @if (Model.Summary.Alerts.Count == 0)
                {
                    <div class="dashboard-empty-state">No recent scan alerts. Platform operations look healthy.</div>
                }
                @foreach (var alert in Model.Summary.Alerts)
                {
                    <article class="dashboard-alert-card">
                        <div class="dashboard-alert-title">@alert.Title</div>
                        <div class="dashboard-alert-detail">@alert.Detail</div>
                    </article>
                }
            </div>
        </section>
    </div>
</div>
